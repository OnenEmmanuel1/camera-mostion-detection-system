<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="fw-bold m-0">Live Camera Stream</h4>
    <p class="text-muted small m-0">Authenticated, session-mediated MJPEG surveillance stream</p>
  </div>
  <div class="d-flex align-items-center gap-2">
    <span class="isss-badge isss-badge-connected" id="live-stream-badge">
      <span class="isss-dot"></span>
      <span id="live-stream-status-text">LIVE</span>
    </span>
  </div>
</div>

<div class="isss-card p-3">
  <% if (disabled) { %>
    <div class="alert alert-warning m-0">
      <h6 class="fw-bold">Live Stream Access Not Available</h6>
      <p class="mb-0"><%= reason %></p>
    </div>
  <% } else { %>
    <div class="isss-media-container" style="min-height: 480px;">
      <img id="isss-live-stream-img" src="/live/stream" class="isss-media-player" alt="Live MJPEG Camera Stream">
    </div>

    <div class="mt-3 d-flex justify-content-between align-items-center text-muted small">
      <div>
        Security Guarantee: Camera device URL/path is protected server-side and never exposed to the client browser.
      </div>
      <div>
        Stream Type: <code>multipart/x-mixed-replace</code>
      </div>
    </div>
  <% } %>
</div>
