<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="fw-bold m-0">Surveillance Events</h4>
    <p class="text-muted small m-0">Historical log of motion occurrences and evidence captures</p>
  </div>
  <div>
    <span class="text-muted small">Total Records: <strong><%= total %></strong></span>
  </div>
</div>

<!-- Filter Bar -->
<div class="isss-card p-3 mb-4">
  <form method="GET" action="/events" class="row g-2 align-items-end">
    <div class="col-md-3">
      <label class="form-label small text-muted m-0">Start Date</label>
      <input type="date" name="start_date" class="form-control form-control-sm" value="<%= query.start_date || '' %>">
    </div>
    <div class="col-md-3">
      <label class="form-label small text-muted m-0">End Date</label>
      <input type="date" name="end_date" class="form-control form-control-sm" value="<%= query.end_date || '' %>">
    </div>
    <div class="col-md-2">
      <label class="form-label small text-muted m-0">Review Status</label>
      <select name="review_status" class="form-select form-select-sm">
        <option value="All" <%= (!query.review_status || query.review_status === 'All') ? 'selected' : '' %>>All Statuses</option>
        <option value="New" <%= query.review_status === 'New' ? 'selected' : '' %>>New</option>
        <option value="Reviewed" <%= query.review_status === 'Reviewed' ? 'selected' : '' %>>Reviewed</option>
        <option value="FalseAlarm" <%= query.review_status === 'FalseAlarm' ? 'selected' : '' %>>False Alarm</option>
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label small text-muted m-0">Detection Type</label>
      <select name="detection_type" class="form-select form-select-sm">
        <option value="All" <%= (!query.detection_type || query.detection_type === 'All') ? 'selected' : '' %>>All Types</option>
        <option value="frame_difference" <%= query.detection_type === 'frame_difference' ? 'selected' : '' %>>Frame Difference</option>
        <option value="running_average" <%= query.detection_type === 'running_average' ? 'selected' : '' %>>Running Average</option>
        <option value="pir" <%= query.detection_type === 'pir' ? 'selected' : '' %>>PIR Sensor</option>
        <option value="camera_and_pir" <%= query.detection_type === 'camera_and_pir' ? 'selected' : '' %>>Camera + PIR</option>
      </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
      <button type="submit" class="isss-btn isss-btn-primary w-100 py-1" style="font-size: 0.85rem;">Filter</button>
      <a href="/events" class="isss-btn isss-btn-secondary py-1" style="font-size: 0.85rem;">Reset</a>
    </div>
  </form>
</div>

<!-- Events Table -->
<div class="isss-card p-0">
  <% if (events.length === 0) { %>
    <div class="p-5 text-center text-muted">
      <h5>No events match the selected criteria</h5>
      <p class="small mb-0">Adjust filters or generate motion activity in front of the camera.</p>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="isss-table m-0">
        <thead>
          <tr>
            <th>Event ID</th>
            <th>Start Time (UTC)</th>
            <th>Duration</th>
            <th>Detection Type</th>
            <th>Peak Area</th>
            <th>Review Status</th>
            <th>Media</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% for (const evt of events) { %>
            <% 
              let durationStr = 'Ongoing';
              if (evt.end_time) {
                const diffMs = new Date(evt.end_time) - new Date(evt.start_time);
                durationStr = `${(diffMs / 1000).toFixed(1)}s`;
              }
            %>
            <tr>
              <td class="font-monospace fw-semibold">
                <a class="isss-event-id-link" href="/events/<%= evt.event_id %>"><%= evt.event_id %></a>
              </td>
              <td class="font-monospace"><%= evt.start_time %></td>
              <td class="font-monospace text-muted"><%= durationStr %></td>
              <td><span class="badge bg-light text-dark border"><%= evt.detection_type %></span></td>
              <td class="font-monospace"><%= evt.changed_area %>%</td>
              <td>
                <span class="isss-badge isss-badge-<%= evt.review_status.toLowerCase() %>">
                  <span class="isss-dot"></span>
                  <span><%= evt.review_status.toUpperCase() %></span>
                </span>
              </td>
              <td>
                <% if (evt.media_path) { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Saved</span>
                <% } else { %>
                  <span class="badge bg-light text-muted border">None</span>
                <% } %>
              </td>
              <td>
                <a href="/events/<%= evt.event_id %>" class="isss-btn isss-btn-secondary py-1 px-2" style="font-size: 0.75rem;">
                  Review &rarr;
                </a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Controls -->
    <% if (totalPages > 1) { %>
      <div class="p-3 border-top d-flex justify-content-between align-items-center">
        <div class="small text-muted">
          Page <strong><%= page %></strong> of <strong><%= totalPages %></strong>
        </div>
        <div class="d-flex gap-1">
          <% if (page > 1) { %>
            <a href="/events?page=<%= page - 1 %>&start_date=<%= query.start_date || '' %>&end_date=<%= query.end_date || '' %>&review_status=<%= query.review_status || '' %>&detection_type=<%= query.detection_type || '' %>" class="isss-btn isss-btn-secondary py-1 px-2" style="font-size: 0.8rem;">&laquo; Prev</a>
          <% } %>
          <% if (page < totalPages) { %>
            <a href="/events?page=<%= page + 1 %>&start_date=<%= query.start_date || '' %>&end_date=<%= query.end_date || '' %>&review_status=<%= query.review_status || '' %>&detection_type=<%= query.detection_type || '' %>" class="isss-btn isss-btn-secondary py-1 px-2" style="font-size: 0.8rem;">Next &raquo;</a>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>
