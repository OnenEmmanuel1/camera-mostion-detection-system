<header class="isss-header d-flex justify-content-between align-items-center">
  <div class="isss-header-status">
    <% const camStatus = (lastCameraStatus && lastCameraStatus.status) ? lastCameraStatus.status : 'Unknown'; %>
    <span class="isss-header-caption">Camera connection</span>
    <div id="header-camera-status" class="isss-badge isss-badge-<%= camStatus.toLowerCase() %>" title="Camera link status">
      <span class="isss-dot"></span><span><%= camStatus.toUpperCase() %></span>
    </div>
  </div>

  <div class="d-flex align-items-center gap-3">
    <div class="text-end">
      <span class="fw-semibold"><%= currentUser.username %></span>
    </div>
    <form action="/logout" method="POST" class="m-0">
      <% if (locals.csrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% } %>
      <button type="submit" class="isss-btn isss-btn-secondary py-1 px-2" style="font-size: 0.8rem;">
        Sign out
      </button>
    </form>
  </div>
</header>
