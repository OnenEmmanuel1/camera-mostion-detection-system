<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h4 class="fw-bold m-0">User Account Management</h4>
    <p class="text-muted small m-0">Access control and credentials administration (No public registration)</p>
  </div>
  <div>
    <span class="badge bg-primary">Administrator Only</span>
  </div>
</div>

<div class="row g-4">
  <!-- Left Column: Existing Users List -->
  <div class="col-lg-8">
    <div class="isss-card p-0">
      <div class="p-3 border-bottom">
        <h5 class="isss-card-title m-0">Authorized Users (<%= users.length %>)</h5>
      </div>

      <div class="table-responsive">
        <table class="isss-table m-0">
          <thead>
            <tr>
              <th>User ID</th>
              <th>Username</th>
              <th>Role</th>
              <th>Status</th>
              <th>Created (UTC)</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% for (const u of users) { %>
              <tr>
                <td class="font-monospace"><%= u.user_id %></td>
                <td class="fw-semibold"><%= u.username %></td>
                <td>
                  <span class="badge <%= u.role === 'Administrator' ? 'bg-primary' : 'bg-secondary' %>">
                    <%= u.role %>
                  </span>
                </td>
                <td>
                  <% if (u.active === 1) { %>
                    <span class="isss-badge isss-badge-connected">
                      <span class="isss-dot"></span> ACTIVE
                    </span>
                  <% } else { %>
                    <span class="isss-badge isss-badge-disconnected">
                      <span class="isss-dot"></span> DISABLED
                    </span>
                  <% } %>
                </td>
                <td class="font-monospace small text-muted"><%= u.created_at %></td>
                <td>
                  <div class="d-flex gap-2">
                    <!-- Toggle Active Form -->
                    <% if (u.user_id !== currentUser.user_id) { %>
                      <form action="/users/<%= u.user_id %>/toggle" method="POST" class="m-0">
                        <% if (locals.csrfToken) { %>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <% } %>
                        <button type="submit" class="isss-btn isss-btn-secondary py-0 px-2" style="font-size: 0.75rem;">
                          <%= u.active === 1 ? 'Disable' : 'Enable' %>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-muted small fst-italic">You</span>
                    <% } %>

                    <!-- Password Reset Button -->
                    <button type="button" class="isss-btn isss-btn-secondary py-0 px-2" style="font-size: 0.75rem;" data-bs-toggle="modal" data-bs-target="#resetModal-<%= u.user_id %>">
                      Reset Password
                    </button>
                  </div>

                  <!-- Reset Password Modal -->
                  <div class="modal fade" id="resetModal-<%= u.user_id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">
                        <form action="/users/<%= u.user_id %>/reset-password" method="POST">
                          <% if (locals.csrfToken) { %>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <% } %>
                          <div class="modal-header">
                            <h5 class="modal-title">Reset Password for <%= u.username %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body">
                            <div class="mb-3">
                              <label class="form-label small fw-semibold">New Password (min 8 chars)</label>
                              <input type="password" name="new_password" class="form-control" required minlength="8">
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="isss-btn isss-btn-secondary py-1" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="isss-btn isss-btn-primary py-1">Save Password</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Right Column: Create User Card -->
  <div class="col-lg-4">
    <div class="isss-card p-3">
      <h5 class="isss-card-title mb-3">Create New Account</h5>
      <form action="/users" method="POST">
        <% if (locals.csrfToken) { %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } %>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Username</label>
          <input type="text" name="username" class="form-control form-control-sm" required pattern="^[a-zA-Z0-9_\-]{3,30}$">
          <div class="text-muted small">3-30 alphanumeric characters.</div>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Initial Password</label>
          <input type="password" name="password" class="form-control form-control-sm" required minlength="8">
          <div class="text-muted small">Minimum 8 characters. Hashed with bcrypt (cost 12).</div>
        </div>

        <div class="mb-4">
          <label class="form-label small fw-semibold">System Role</label>
          <select name="role" class="form-select form-select-sm" required>
            <option value="Viewer">Viewer (Status, events, and permitted media)</option>
            <option value="Administrator">Administrator (Full settings, users, audit)</option>
          </select>
        </div>

        <button type="submit" class="isss-btn isss-btn-primary w-100 py-2">
          Create Account
        </button>
      </form>
    </div>
  </div>
</div>
