# ISSS Environment Configuration Template
# Copy to .env and configure for your deployment environment

# Environment: 'demo', 'development', or 'production'
# In 'demo', demo seeding is allowed and demo banners are shown to administrators.
# In 'production', demo seeding is blocked; use 'npm run create-admin' instead.
APP_ENV=demo

# Server Binding
PORT=3000
HOST=0.0.0.0

# Session Secret (Replace with a cryptographically secure random string in production)
SESSION_SECRET=

# Persistence Paths
DATABASE_PATH=data/isss.sqlite
MEDIA_ROOT=media

# Camera Acquisition
# CAMERA_TYPE: 'file' (replay video), 'usb' (v4l2 or DirectShow), 'url' (RTSP or HTTP)
CAMERA_TYPE=file
CAMERA_PATH=evaluation/synthetic_test.mp4
# Optional explicit path to ffmpeg binary (defaults to system ffmpeg or ffmpeg-static)
FFMPEG_PATH=

# Node Identification
DEVICE_NAME=ISSS-Edge-Node-01
DEVICE_LOCATION=Main Entrance
DEVICE_API_KEY=
# Public HTTPS site URL used in email and Telegram event links (set to Vercel domain in split deployments)
PUBLIC_APP_URL=http://localhost:3000

# Timezone Display Policy (Database stores strictly UTC; UI formats in this zone)
DISPLAY_TZ=UTC

# Email Notifications (SMTP) - Optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# Telegram Bot Notifications - Optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opt-in Still Attachment in Notifications (Default false per Section 5.8)
NOTIFY_ATTACH_IMAGE=false
